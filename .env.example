# Environment variable reference for local development.
#
# Copy this file to `.env` and adjust values as needed:
#   cp .env.example .env
#
# This file lists variable NAMES with safe placeholder/default values only.
# It must never contain real secrets, keys, or credentials (STORY-006).
# `.env` itself is git-ignored; only this example file is tracked.
#
# NOTE: the services referenced below (backend, frontend, Postgres, Redis,
# Docker Compose) are not implemented yet — see requirement.md STORY-004/005/007/008.
# This file anticipates the configuration they will need.

# --- General ---
APP_ENV=development
LOG_LEVEL=info

# --- Backend API (FastAPI) ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
# Placeholder only — replace with a securely generated value in any real environment.
SECRET_KEY=changeme-dev-secret

# --- PostgreSQL ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=job_platform
POSTGRES_USER=job_platform
# Placeholder only — replace with a securely generated value in any real environment.
POSTGRES_PASSWORD=changeme
DATABASE_URL=postgresql+psycopg2://job_platform:changeme@postgres:5432/job_platform

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# --- Ingestion / Connectors (STORY-017) ---
# Sent as the User-Agent on every outbound connector request. Not a secret --
# replace with a real, contactable identifier before any real connector runs.
INGESTION_USER_AGENT=JobPlatformBot/1.0

# --- CORS (STORY-035) ---
# The only origin allowed to read cross-origin responses from the backend API
# (the frontend's own origin). Not a secret.
CORS_ALLOWED_ORIGIN=http://localhost:3000

# --- Rate limiting (STORY-045) ---
# Per-IP fixed-window limit on public endpoints (e.g. GET /jobs/search).
# Not a secret.
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# --- Scheduled refresh (STORY-021) ---
# Global fallback used when a Source's own refresh_interval_minutes is NULL.
# Not a secret.
DEFAULT_REFRESH_INTERVAL_MINUTES=60
# How often the scheduler process wakes to check for due sources. Not a secret.
SCHEDULER_POLL_INTERVAL_SECONDS=60
# Lets the scheduler container no-op without removing it from Compose. Not a secret.
SCHEDULER_ENABLED=true

# --- Frontend (Next.js) ---
FRONTEND_PORT=3000
# Browser-exposed API base URL — must use the NEXT_PUBLIC_ prefix per Next.js convention.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
